{
  "name": "simple-docs",
  "version": "1.0.0",
  "private": true,
  "description": "A personal local-first documentation viewer for real folders on your computer.",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"next dev\" \"wait-on http://localhost:3000 && electron . --dev\"",
    "build": "next build",
    "start": "concurrently -k \"next start\" \"wait-on http://localhost:3000 && electron .\"",
    "lint": "eslint",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "dompurify": "^3.4.16",
    "lucide-react": "^1.48.0",
    "marked": "^18.0.14",
    "next": "16.3.2",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "archiver": "^7.0.1",
    "concurrently": "^9.2.1",
    "electron": "41.10.6",
    "eslint": "^9",
    "eslint-config-next": "16.3.2",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wait-on": "^9.0.1"
  }
}